# Copy to .env (never commit .env)
LLM_PROVIDER=ollama          # ollama | anthropic | openai
LLM_MODEL=llama3.1:8b        # e.g. qwen2.5:14b (ollama), claude-sonnet-5-5 / claude-haiku-5-5 (anthropic), gpt-4o-mini (openai)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384       # context window for Ollama; the agent conversation needs more than the 2-4k default

# Free option: Google Gemini native API (key from aistudio.google.com)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=<your key>
# LLM_MODEL=gemini-3.8-flash
# LLM_MAX_TOKENS=8000         # thinking models spend part of the output budget on hidden reasoning
# LLM_MIN_INTERVAL=4          # seconds between requests; keeps free tiers under their per-minute limit
